# CEO AI Operating System - Environment Configuration

# AI Providers
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Primary AI Provider: groq | openai | anthropic | local
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_URL=sqlite:///./data/ceo_os.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/ceo_os

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Security
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars
ENCRYPTION_KEY=generate_with_python_Fernet_generate_key

# Scanner
SCAN_ROOT=~/
SCAN_EXCLUDE=.git,node_modules,__pycache__,.venv,venv,.cache,tmp

# System
DEBUG=false
PORT=8000
FRONTEND_URL=http://localhost:3000

# GitHub (for Deployment Agent)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username

# Render (for deployment)
RENDER_API_KEY=your_render_api_key_here

# Memory
MEMORY_TTL_DAYS=90
MAX_AGENTS_CONCURRENT=5
